# Copy to backend/.env and fill in.

MONGODB_URI=mongodb://localhost:27017/nst-entrepreneurship
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Email (Resend). The sender's domain must be verified in Resend. Both
# "Name <address>" and "Name address" work. Without these two, emails are
# logged as failed and not sent.
RESEND_API_KEY=
EMAIL_FROM=NST Entrepreneurship <noreply@yourdomain.com>
# Where links in emails point. Defaults to FRONTEND_URL.
APP_URL=http://localhost:5173

# Mentor check-ins on Google Calendar and Meet (see the README). A separate
# OAuth client for mentors keeps the calendar scopes off student sign-in;
# without it the GOOGLE_CLIENT_* values above are used.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Encrypts mentors' Google tokens: openssl rand -base64 32 (or -hex 32)
GOOGLE_TOKEN_KEY=

# Behind a reverse proxy: the number of proxy hops, e.g. 1.
# TRUST_PROXY=1
