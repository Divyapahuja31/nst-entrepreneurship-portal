{
  "name": "nst-entrepreneurship-portal",
  "version": "1.0.0",
  "description": "",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm run build",
    "start": "npm start -w backend",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "prettify": "concurrently \"cd backend && npm run prettify\" \"cd frontend && npm run prettify\"",
    "lint": "eslint ./backend ./frontend",
    "lint-fix": "eslint ./backend ./frontend --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Divyapahuja31/nst-entrepreneurship-portal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Divyapahuja31/nst-entrepreneurship-portal/issues"
  },
  "homepage": "https://github.com/Divyapahuja31/nst-entrepreneurship-portal#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "9.13.0",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings 0"
    ],
    "**/*": [
      "npx cspell --no-summary --no-progress --no-must-find-files"
    ]
  }
}
